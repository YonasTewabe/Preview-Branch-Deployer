# Backend (Express)
NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-strong-secret
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
